# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=quotes_db

# Cron auth (Railway cron / FBPost_CronJobs should send this as Bearer token or X-Cron-Secret)
CRON_SECRET=

# Facebook Graph API (page access token for Postmilstill page 109666208522653)
FACEBOOK_PAGE_ACCESS_TOKEN=
# Alternative name also supported:
# FB_PAGE_ACCESS_TOKEN=

# X / Twitter API v2 (OAuth 1.0a user context — Read + Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Quote rotation uses MongoDB collections:
# - quote_list_cursors (shared lastIndex per quoteListId across schedules)
# - post_history (24h dedup per pageId)
